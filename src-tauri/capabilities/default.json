[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capabilities for the LTools main window",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:allow-hide",
      "core:window:allow-is-always-on-top",
      "core:window:allow-set-always-on-top",
      "core:window:allow-minimize",
      "core:window:allow-toggle-maximize",
      "core:window:allow-close",
      "core:window:allow-is-maximized",
      "core:window:allow-start-dragging",
      "autostart:default",
      "dialog:default",
      "global-shortcut:default",
      "opener:default",
      "updater:default"
    ]
  },
  {
    "identifier": "search",
    "description": "Capabilities for the quick search window (label=search)",
    "windows": ["search"],
    "permissions": [
      "core:default",
      "core:event:default",
      "opener:default"
    ]
  }
]
